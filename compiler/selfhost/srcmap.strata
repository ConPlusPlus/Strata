//
// selfhost/srcmap.strata - maps a line of the module-resolved source back to its origin file.
// Part of the CORE (shared data). `import Name` pastes modules into one text before
// lexing, so token line numbers index that combined text; the driver records, per
// combined line, where it came from, and diagnostics translate through this map.

struct SrcMap {
    string[dynamic] files// files[i] / lines[i] describe combined line i+1
    int[dynamic] lines
}

SrcMap* new_srcmap() {
    string[dynamic] f = []
    int[dynamic] n = []
    return alloc(SrcMap{ f, n })
}

// "file:line:col" for a combined-source position; falls back to `file` if unmapped.
string src_loc(SrcMap* m, string file, int line, int col) {
    if (m != null && line >= 1 && line <= m.lines.len) {
        return m.files[line - 1] + ":" + int_to_str(m.lines[line - 1]) + ":" + int_to_str(col)
    }
    return file + ":" + int_to_str(line) + ":" + int_to_str(col)
}
