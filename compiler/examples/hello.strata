// hello.strata - the flagship: structs, first-class vec3, arena memory, no GC.
// A tiny "entity" integrates its position over 60 frames, then prints how far it moved.

struct Entity {
    vec3 pos
    vec3 vel
    int  hp
}

vec3 update(Entity* e, float dt) {
    e.pos += e.vel * dt        // first-class vector math; '.' auto-derefs
    return e.pos
}

print("hello, strata")

var world = arena()            // a region — everything in it dies together
var e = world.new(Entity)      // no malloc, no free
e.hp = 100
e.vel = vec3(1, 0, 0)

for i in 0..60 {
    update(e, 0.016)
}

print(length(e.pos))           // distance travelled ≈ 0.96
