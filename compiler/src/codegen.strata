//
// src/codegen.strata - the Strata code generator, written in Strata (originally ported from D--; a MODULE, no main). CORE.
//
// Milestone 1, step 3: the thin vertical slice. Turns the AST into plain C for the
// subset that lets a program actually RUN end-to-end BEFORE the checker exists
// (ARCHITECTURE.md sec 7): functions (types-first), integer/bool/float/string values,
// arithmetic, calls, `if`/`while`/`for..in` over ranges, `return`, and `print`.
//
// Deliberately NOT here yet (they need the checker + the lib/ runtime): structs, vec/mat,
// arenas/regions, arrays, method/UFCS calls. gen_* flags those as errors rather than
// emitting broken C. `var`/`const` without a checker lean on gcc's `__auto_type`.

// AST + Parser (brings lexer/token)
import parser
import "strata_host.h"   // strata_join
import ast

// Output is collected as a list of pieces and joined once at the end: appending to one
// growing string copies all of it every time (Strata strings are immutable C strings),
// which made big programs take gigabytes.
export struct Codegen { string[dynamic] parts; bool had_error; bool no_main; }   // no_main: building a dll

export Codegen new_codegen() {
    string[dynamic] parts = []
    return Codegen{ parts, false, false }
}

void cg_out(Codegen* cg, string s) { cg.parts.push(s) }

// Join the pieces in one pass (strata_join in strata_host.h: one allocation, one copy).
string join_pieces(string[dynamic] pieces) { return strata_join(&pieces) }

// ---- helpers -----------------------------------------------------------

string cg_indent(int n) { string r = ""; for i in 0..n { r = r + "    "; } return r; }

string cg_strip_us(string s) {   // C rejects `_` digit separators; drop them
    string r = ""
    for i in 0..s.len { if (s[i] != '_') { r = r + substr(s, i, 1); } }
    return r
}

// A literal's text arrives as written in the source (see lexer.strata), and every Strata
// escape is a C escape, so it passes through. The one rewrite: `\0` becomes `\000`,
// because in C a digit right after `\0` would extend it into a different octal escape.
string cg_escape(string s) {
    string r = ""
    int i = 0
    while (i < s.len) {
        if (s[i] == '\\' && i + 1 < s.len) {
            if (s[i + 1] == '0') { r = r + "\\000"; }
            else                 { r = r + substr(s, i, 2); }
            i += 2
        } else {
            r = r + substr(s, i, 1)
            i += 1
        }
    }
    return r
}

// Map a Strata type NAME to its C spelling (struct/user names pass through unchanged).
string cname(string n) {
    if (n == "int")    { return "int64_t"; }
    if (n == "float")  { return "float"; }
    if (n == "bool")   { return "bool"; }
    if (n == "void")   { return "void"; }
    if (n == "string") { return "const char*"; }
    if (n == "char")   { return "char"; }
    // sized numerics
    if (n == "i8")  { return "int8_t"; }
    if (n == "i16") { return "int16_t"; }
    if (n == "i32") { return "int32_t"; }
    if (n == "i64") { return "int64_t"; }
    if (n == "u8")  { return "uint8_t"; }
    if (n == "u16") { return "uint16_t"; }
    if (n == "u32") { return "uint32_t"; }
    if (n == "u64" || n == "uint") { return "uint64_t"; }
    if (n == "f32") { return "float"; }
    if (n == "f64") { return "double"; }
    return n
}

string ty_to_c(TypeNode* t) {
    if (t == null) { return "void"; }
    switch (t.kind) {
        case TyNamed:      return cname(t.name)
        case TyPointer:    return ty_to_c(t.elem) + "*"
        case TyArray:      return ty_to_c(t.elem) + "*"// minimal: decay to pointer
        case TyFixedArray: return ty_to_c(t.elem) + "*"
        case TyDynArray:   return "Array"// the type-erased dynamic array
    }
    return "void"
}

// ---- vector helpers (read the checker's rtype annotations) --------------
bool cg_is_vec_name(string n) { return n == "vec2" || n == "vec3" || n == "vec4"; }
int  cg_vec_size(string n) { if (n == "vec2") { return 2; } if (n == "vec3") { return 3; } if (n == "vec4") { return 4; } return 0; }
bool cg_is_vec_rt(TypeNode* t) { if (t == null) { return false; } if (t.kind != TyNamed) { return false; } return cg_is_vec_name(t.name); }
string  cg_vec_name_rt(TypeNode* t) { if (cg_is_vec_rt(t)) { return t.name; } return ""; }
bool cg_is_mat_rt(TypeNode* t)  { if (t == null) { return false; } return t.kind == TyNamed && t.name == "mat4"; }
bool cg_is_quat_rt(TypeNode* t) { if (t == null) { return false; } return t.kind == TyNamed && t.name == "quat"; }
bool cg_is_str_rt(TypeNode* t)  { if (t == null) { return false; } return t.kind == TyNamed && t.name == "string"; }
bool cg_is_dynarr_rt(TypeNode* t) { if (t == null) { return false; } return t.kind == TyDynArray; }
string  cg_dynarr_elem(TypeNode* t)  { if (cg_is_dynarr_rt(t) && t.elem != null) { return ty_to_c(t.elem); } return "char"; }

// ---- expressions -------------------------------------------------------

string gen_call(Codegen* cg, Expr* e) {
    // arena() -> a fresh arena
    if (e.a.kind == ExName && e.a.text == "arena" && e.items.len == 0) { return "arena_make()"; }

    // <arena>.new(T) -> (T*)arena_alloc(&<arena>, sizeof(T))
    if (e.a.kind == ExField && e.a.field == "new" && e.items.len == 1 && e.items[0].kind == ExName) {
        string recv  = gen_expr(cg, e.a.a)
        string tname = cname(e.items[0].text)
        return "(" + tname + "*)arena_alloc(&" + recv + ", sizeof(" + tname + "))"
    }

    // dynamic array push: xs.push(v) -> ({ ELEM _e = v; arr_push(&(xs), &_e); })
    if (e.a.kind == ExField && e.a.field == "push" && e.items.len == 1 && cg_is_dynarr_rt(e.a.a.rtype)) {
        string elemc = cg_dynarr_elem(e.a.a.rtype)
        string recv  = gen_expr(cg, e.a.a)
        string val   = gen_expr(cg, e.items[0])
        return "({ " + elemc + " _e = " + val + "; arr_push(&(" + recv + "), &_e); })"
    }

    // `print(x)` - temporary built-in until the real prelude lands: %s for a string
    // literal, else print as a 64-bit int.
    if (e.a.kind == ExName && e.a.text == "print" && e.items.len == 1) {
        Expr* arg = e.items[0]
        if (arg.kind == ExStringLit) { return "printf(\"%s\\n\", " + gen_expr(cg, arg) + ")"; }
        if (cg_is_str_rt(arg.rtype)) { return "printf(\"%s\\n\", " + gen_expr(cg, arg) + ")"; }
        if (arg.rtype != null && arg.rtype.kind == TyNamed && (arg.rtype.name == "float" || arg.rtype.name == "f32" || arg.rtype.name == "f64")) {
            return "printf(\"%g\\n\", (double)(" + gen_expr(cg, arg) + "))"
        }
        return "printf(\"%lld\\n\", (long long)(" + gen_expr(cg, arg) + "))"
    }

    // vector constructors + math builtins
    if (e.a.kind == ExName) {
        string nm = e.a.text
        if (cg_is_vec_name(nm)) {
            int n = cg_vec_size(nm)
            string s = "(" + nm + "){"
            if (e.items.len == 1 && n > 1) {
                string v = gen_expr(cg, e.items[0])
                for i in 0..n { if (i > 0) { s = s + ", "; } s = s + v; }
            } else {
                for i in 0..e.items.len { if (i > 0) { s = s + ", "; } s = s + gen_expr(cg, e.items[i]); }
            }
            return s + "}"
        }
        if (nm == "dot" && e.items.len == 2) {
            string vn = cg_vec_name_rt(e.items[0].rtype)
            if (vn.len == 0) { vn = cg_vec_name_rt(e.items[1].rtype); }
            return vn + "_dot(" + gen_expr(cg, e.items[0]) + ", " + gen_expr(cg, e.items[1]) + ")"
        }
        if (nm == "cross" && e.items.len == 2) { return "vec3_cross(" + gen_expr(cg, e.items[0]) + ", " + gen_expr(cg, e.items[1]) + ")"; }
        if (nm == "length" && e.items.len == 1) { return cg_vec_name_rt(e.items[0].rtype) + "_length(" + gen_expr(cg, e.items[0]) + ")"; }
        if (nm == "normalize" && e.items.len == 1) { return cg_vec_name_rt(e.items[0].rtype) + "_normalize(" + gen_expr(cg, e.items[0]) + ")"; }
        // alloc(value) -> box a copy in the global heap, return a pointer
        if (nm == "alloc" && e.items.len == 1) {
            string ct = "int64_t"
            if (e.items[0].rtype != null) { ct = ty_to_c(e.items[0].rtype); }
            return "({ " + ct + " _v = " + gen_expr(cg, e.items[0]) + "; " + ct + "* _p = (" + ct + "*)arena_alloc(strata_heap(), sizeof(" + ct + ")); *_p = _v; _p; })"
        }
        // string + file built-ins
        if (nm == "substr" && e.items.len == 3) { return "str_sub(" + gen_expr(cg, e.items[0]) + ", " + gen_expr(cg, e.items[1]) + ", " + gen_expr(cg, e.items[2]) + ")"; }
        if (nm == "int_to_str" && e.items.len == 1) { return "str_from_int(" + gen_expr(cg, e.items[0]) + ")"; }
        if (nm == "read_file" && e.items.len == 1) { return "strata_read_file(" + gen_expr(cg, e.items[0]) + ")"; }
        if (nm == "write_file" && e.items.len == 2) { return "strata_write_file(" + gen_expr(cg, e.items[0]) + ", " + gen_expr(cg, e.items[1]) + ")"; }
        if (nm == "args" && e.items.len == 0) { return "strata_args()"; }
        if (nm == "cstr" && e.items.len == 1) { return "(" + gen_expr(cg, e.items[0]) + ")"; }   // string already IS a C string
        // prelude helpers
        if (nm == "min" && e.items.len == 2) { return "sp_min(" + gen_expr(cg, e.items[0]) + ", " + gen_expr(cg, e.items[1]) + ")"; }
        if (nm == "max" && e.items.len == 2) { return "sp_max(" + gen_expr(cg, e.items[0]) + ", " + gen_expr(cg, e.items[1]) + ")"; }
        if (nm == "clamp" && e.items.len == 3) { return "sp_clamp(" + gen_expr(cg, e.items[0]) + ", " + gen_expr(cg, e.items[1]) + ", " + gen_expr(cg, e.items[2]) + ")"; }
        if (nm == "lerp" && e.items.len == 3) { return "sp_lerp(" + gen_expr(cg, e.items[0]) + ", " + gen_expr(cg, e.items[1]) + ", " + gen_expr(cg, e.items[2]) + ")"; }
    }

    string s = gen_expr(cg, e.a) + "("
    for i in 0..e.items.len { if (i > 0) { s = s + ", "; } s = s + gen_expr(cg, e.items[i]); }
    return s + ")"
}

string gen_expr(Codegen* cg, Expr* e) {
    if (e == null) { return "0"; }
    switch (e.kind) {
        case ExIntLit:    return cg_strip_us(e.text)
        case ExFloatLit:  return cg_strip_us(e.text)
        case ExStringLit: return "\"" + cg_escape(e.text) + "\""
        case ExCharLit:   return "'" + cg_escape(e.text) + "'"
        case ExBoolLit:   if (e.bval) { return "true"; } return "false"
        case ExName:      if (e.text == "PI") { return "SP_PI"; } if (e.text == "null") { return "0"; } return e.text
        case ExUnary:     return "(" + e.text + gen_expr(cg, e.a) + ")"
        case ExBinary:
            {
                if (e.text == "..") { cg.had_error = true; return "0"; }   // ranges only in for..in
                if (cg_is_mat_rt(e.a.rtype) || cg_is_quat_rt(e.a.rtype) || cg_is_mat_rt(e.b.rtype) || cg_is_quat_rt(e.b.rtype)) {
                    string ma = gen_expr(cg, e.a)
                    string mb = gen_expr(cg, e.b)
                    if (cg_is_mat_rt(e.a.rtype) && cg_is_mat_rt(e.b.rtype)) { return "mat4_mul(" + ma + ", " + mb + ")"; }
                    if (cg_is_mat_rt(e.a.rtype) && cg_is_vec_rt(e.b.rtype)) { return "mat4_mul_vec4(" + ma + ", " + mb + ")"; }
                    if (cg_is_quat_rt(e.a.rtype) && cg_is_quat_rt(e.b.rtype)) { return "quat_mul(" + ma + ", " + mb + ")"; }
                    cg.had_error = true
                    return "0"
                }
                bool av = cg_is_vec_rt(e.a.rtype)
                bool bv = cg_is_vec_rt(e.b.rtype)
                if (av || bv) {
                    string vn = cg_vec_name_rt(e.a.rtype)
                    if (vn.len == 0) { vn = cg_vec_name_rt(e.b.rtype); }
                    string va = gen_expr(cg, e.a)
                    string vb = gen_expr(cg, e.b)
                    if (e.text == "+") { return vn + "_add(" + va + ", " + vb + ")"; }
                    if (e.text == "-") { return vn + "_sub(" + va + ", " + vb + ")"; }
                    if (e.text == "*") {
                        if (av && bv) { return vn + "_mul(" + va + ", " + vb + ")"; }
                        if (av)       { return vn + "_scale(" + va + ", " + vb + ")"; }
                        return vn + "_scale(" + vb + ", " + va + ")"
                    }
                    cg.had_error = true
                    return "0"
                }
                if (cg_is_str_rt(e.a.rtype) || cg_is_str_rt(e.b.rtype)) {
                    string sa = gen_expr(cg, e.a)
                    string sb = gen_expr(cg, e.b)
                    if (e.text == "+")  { return "str_concat(" + sa + ", " + sb + ")"; }
                    if (e.text == "==") { return "str_eq(" + sa + ", " + sb + ")"; }
                    if (e.text == "!=") { return "(!str_eq(" + sa + ", " + sb + "))"; }
                    cg.had_error = true
                    return "0"
                }
                return "(" + gen_expr(cg, e.a) + " " + e.text + " " + gen_expr(cg, e.b) + ")"
            }
        case ExCall:  return gen_call(cg, e)
        case ExField:
            {
                // string length: s.len -> str_len(s)
                if (cg_is_str_rt(e.a.rtype) && e.field == "len") { return "str_len(" + gen_expr(cg, e.a) + ")"; }
                // multi-component swizzle on a vector: v.xy -> (vec2){(v).x, (v).y}
                if (cg_is_vec_rt(e.a.rtype) && e.field.len > 1) {
                    string base = gen_expr(cg, e.a)
                    string vt = "vec2"
                    if (e.field.len == 3) { vt = "vec3"; }
                    if (e.field.len == 4) { vt = "vec4"; }
                    string s = "(" + vt + "){"
                    for i in 0..e.field.len { if (i > 0) { s = s + ", "; } s = s + "(" + base + ")." + substr(e.field, i, 1); }
                    return s + "}"
                }
                // `.` auto-derefs: if the receiver is a pointer (per the checker's rtype), use `->`.
                string op = "."
                if (e.a.rtype != null && e.a.rtype.kind == TyPointer) { op = "->"; }
                return gen_expr(cg, e.a) + op + e.field
            }
        case ExIndex:
            {
                if (cg_is_dynarr_rt(e.a.rtype)) {
                    string elemc = cg_dynarr_elem(e.a.rtype)
                    return "((" + elemc + "*)(" + gen_expr(cg, e.a) + ").data)[" + gen_expr(cg, e.b) + "]"
                }
                return gen_expr(cg, e.a) + "[" + gen_expr(cg, e.b) + "]"
            }
        case ExArrayLit:
            {
                string elemc = "int64_t"
                if (e.rtype != null && e.rtype.kind == TyDynArray && e.rtype.elem != null) { elemc = ty_to_c(e.rtype.elem); }
                string s = "({ Array _a = arr_make(sizeof(" + elemc + "));"
                for i in 0..e.items.len {
                    s = s + " { " + elemc + " _e = " + gen_expr(cg, e.items[i]) + "; arr_push(&_a, &_e); }"
                }
                return s + " _a; })"
            }
        case ExStructLit:
            {
                string s = "(" + cname(e.type_name) + "){"
                for i in 0..e.items.len { if (i > 0) { s = s + ", "; } s = s + gen_expr(cg, e.items[i]); }
                return s + "}"
            }
        case ExCast:   return "((" + ty_to_c(e.type) + ")(" + gen_expr(cg, e.a) + "))"
        case ExSizeof: return "((int64_t)sizeof(" + ty_to_c(e.type) + "))"
        default:      cg.had_error = true; return "0"
    }
    return "0"
}

// ---- statements --------------------------------------------------------

void gen_braced(Codegen* cg, int ind, Stmt* blk) {
    cg_out(cg, "{\n")
    if (blk != null && blk.kind == StBlock) {
        for i in 0..blk.stmts.len { gen_stmt(cg, ind + 1, blk.stmts[i]); }
    }
    cg_out(cg, cg_indent(ind) + "}")
}

void gen_stmt(Codegen* cg, int ind, Stmt* s) {
    if (s == null) { return; }
    switch (s.kind) {
        case StBlock:
            cg_out(cg, cg_indent(ind)); gen_braced(cg, ind, s); cg_out(cg, "\n")
        case StVar:
            {
                string ct = "__auto_type"
                if (s.type != null) { ct = ty_to_c(s.type); }
                string head = ""
                if (s.is_const) { head = "const "; }
                if (s.init != null) {
                    cg_out(cg, cg_indent(ind) + head + ct + " " + s.name + " = " + gen_expr(cg, s.init) + ";\n")
                } else if (s.type != null && s.type.kind == TyDynArray) {
                    // an uninitialized dynamic array starts empty (arena/heap not yet allocated)
                    cg_out(cg, cg_indent(ind) + "Array " + s.name + " = arr_make(sizeof(" + ty_to_c(s.type.elem) + "));\n")
                } else {
                    cg_out(cg, cg_indent(ind) + head + ct + " " + s.name + ";\n")
                }
            }
        case StReturn:
            if (s.expr != null) { cg_out(cg, cg_indent(ind) + "return " + gen_expr(cg, s.expr) + ";\n"); }
            else                { cg_out(cg, cg_indent(ind) + "return;\n"); }
        case StExprStmt:
            cg_out(cg, cg_indent(ind) + gen_expr(cg, s.expr) + ";\n")
        case StAssign:
            {
                // compound assignment on a vector lowers to `target = vecN_op(target, value)`
                if (s.op != "=" && cg_is_vec_rt(s.target.rtype)) {
                    string vn  = cg_vec_name_rt(s.target.rtype)
                    string tgt = gen_expr(cg, s.target)
                    string val = gen_expr(cg, s.value)
                    string rhs = "0"
                    if (s.op == "+=")      { rhs = vn + "_add(" + tgt + ", " + val + ")"; }
                    else if (s.op == "-=") { rhs = vn + "_sub(" + tgt + ", " + val + ")"; }
                    else if (s.op == "*=") {
                        if (cg_is_vec_rt(s.value.rtype)) { rhs = vn + "_mul(" + tgt + ", " + val + ")"; }
                        else                             { rhs = vn + "_scale(" + tgt + ", " + val + ")"; }
                    }
                    else { cg.had_error = true; }
                    cg_out(cg, cg_indent(ind) + tgt + " = " + rhs + ";\n")
                } else {
                    cg_out(cg, cg_indent(ind) + gen_expr(cg, s.target) + " " + s.op + " " + gen_expr(cg, s.value) + ";\n")
                }
            }
        case StIf:
            cg_out(cg, cg_indent(ind) + "if (" + gen_expr(cg, s.cond) + ") ")
            gen_braced(cg, ind, s.then_block)
            if (s.else_branch != null) {
                cg_out(cg, " else ")
                if (s.else_branch.kind == StIf) { cg_out(cg, "\n"); gen_stmt(cg, ind, s.else_branch); }
                else { gen_braced(cg, ind, s.else_branch); cg_out(cg, "\n"); }
            } else {
                cg_out(cg, "\n")
            }
        case StWhile:
            cg_out(cg, cg_indent(ind) + "while (" + gen_expr(cg, s.cond) + ") ")
            gen_braced(cg, ind, s.body); cg_out(cg, "\n")
        case StForIn:
            if (s.iter != null && s.iter.kind == ExBinary && s.iter.text == "..") {
                string lo = gen_expr(cg, s.iter.a)
                string hi = gen_expr(cg, s.iter.b)
                cg_out(cg, cg_indent(ind) + "for (int64_t " + s.name + " = " + lo + "; " +
                           s.name + " < " + hi + "; " + s.name + "++) ")
                gen_braced(cg, ind, s.body); cg_out(cg, "\n")
            } else if (cg_is_dynarr_rt(s.iter.rtype)) {
                string elemc = cg_dynarr_elem(s.iter.rtype)
                string arrx = gen_expr(cg, s.iter)
                cg_out(cg, cg_indent(ind) + "{ Array _arr = " + arrx + ";\n")
                cg_out(cg, cg_indent(ind + 1) + "for (int64_t _i = 0; _i < _arr.len; _i++) {\n")
                cg_out(cg, cg_indent(ind + 2) + elemc + " " + s.name + " = ((" + elemc + "*)_arr.data)[_i];\n")
                if (s.body != null && s.body.kind == StBlock) {
                    for i in 0..s.body.stmts.len { gen_stmt(cg, ind + 2, s.body.stmts[i]); }
                }
                cg_out(cg, cg_indent(ind + 1) + "}\n")
                cg_out(cg, cg_indent(ind) + "}\n")
            } else {
                cg.had_error = true
                cg_out(cg, cg_indent(ind) + "/* unsupported for-in iterable */\n")
            }
        case StSwitch:
            cg_out(cg, cg_indent(ind) + "switch (" + gen_expr(cg, s.subject) + ") {\n")
            for i in 0..s.cases.len {
                SwitchCase sc = s.cases[i]
                if (sc.is_default) {
                    cg_out(cg, cg_indent(ind + 1) + "default: {\n")
                } else {
                    for j in 0..sc.values.len {
                        cg_out(cg, cg_indent(ind + 1) + "case " + gen_expr(cg, sc.values[j]) + ":\n")
                    }
                    cg_out(cg, cg_indent(ind + 1) + "{\n")
                }
                if (sc.body != null && sc.body.kind == StBlock) {
                    for j in 0..sc.body.stmts.len { gen_stmt(cg, ind + 2, sc.body.stmts[j]); }
                }
                cg_out(cg, cg_indent(ind + 2) + "break;\n")
                cg_out(cg, cg_indent(ind + 1) + "}\n")
            }
            cg_out(cg, cg_indent(ind) + "}\n")
        case StRegion:
            {
                string rname = s.name
                if (rname.len == 0) { rname = "_region"; }
                cg_out(cg, cg_indent(ind) + "{\n")
                cg_out(cg, cg_indent(ind + 1) + "Arena " + rname + " = arena_make();\n")
                if (s.body != null && s.body.kind == StBlock) {
                    for i in 0..s.body.stmts.len { gen_stmt(cg, ind + 1, s.body.stmts[i]); }
                }
                cg_out(cg, cg_indent(ind + 1) + "arena_free(&" + rname + ");\n")
                cg_out(cg, cg_indent(ind) + "}\n")
            }
        default:
            cg.had_error = true
    }
}

// ---- program -----------------------------------------------------------

string func_sig(Decl* d) {
    string s = ty_to_c(d.ret) + " " + d.name + "("
    if (d.params.len == 0) { s = s + "void"; }
    else {
        for i in 0..d.params.len {
            if (i > 0) { s = s + ", "; }
            s = s + ty_to_c(d.params[i].type) + " " + d.params[i].name
        }
    }
    return s + ")"
}

// In a dll, the entry module's exported functions are the library's entry points.
bool is_dll_export(Codegen* cg, Decl* d) { return cg.no_main && d.module == 0 && d.is_exported }

string export_prefix(Codegen* cg, Decl* d) {
    if is_dll_export(cg, d) { return "STRATA_EXPORT " }
    return ""
}

// ---- the pieces of a C translation unit ------------------------------------------

// the runtime headers, the program's C imports, and (for a dll) STRATA_EXPORT
void gen_includes(Codegen* cg, Program prog) {
    cg_out(cg, "#include <stdint.h>\n")
    cg_out(cg, "#include <stdbool.h>\n")
    cg_out(cg, "#include <stdio.h>\n")
    cg_out(cg, "#include <arena.h>\n")
    cg_out(cg, "#include <smath.h>\n")
    cg_out(cg, "#include <sstr.h>\n")
    cg_out(cg, "#include <sio.h>\n")
    cg_out(cg, "#include <sarr.h>\n")
    cg_out(cg, "#include <sprelude.h>\n")

    // imported C headers (interop)
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if (d.kind == DcInclude) {
            if (d.is_system) { cg_out(cg, "#include <" + d.path + ">\n"); }
            else             { cg_out(cg, "#include \"" + d.path + "\"\n"); }
        }
    }
    if cg.no_main {
        // a dll exports only what STRATA_EXPORT marks (the entry module's exports)
        cg_out(cg, "#ifdef _WIN32\n#define STRATA_EXPORT __declspec(dllexport)\n#else\n#define STRATA_EXPORT __attribute__((visibility(\"default\")))\n#endif\n")
    }
    cg_out(cg, "\n")
}

// enums and structs (every module's: types are shared by the whole program)
void gen_types(Codegen* cg, Program prog) {
    // enums -> C enums (members become C integer constants)
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if (d.kind == DcEnum) {
            cg_out(cg, "typedef enum {")
            for m in 0..d.members.len { if (m > 0) { cg_out(cg, ","); } cg_out(cg, " " + d.members[m]); }
            cg_out(cg, " } " + d.name + ";\n")
        }
    }

    // struct tags forward-declared first (so fields can reference any struct), then defined
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if (d.kind == DcStruct) { cg_out(cg, "typedef struct " + d.name + " " + d.name + ";\n"); }
    }
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if (d.kind == DcStruct) {
            cg_out(cg, "struct " + d.name + " {\n")
            for f in 0..d.fields.len {
                cg_out(cg, "    " + ty_to_c(d.fields[f].type) + " " + d.fields[f].name + ";\n")
            }
            cg_out(cg, "};\n")
        }
    }
    cg_out(cg, "\n")
}

void gen_function(Codegen* cg, Decl* d, string prefix) {
    cg_out(cg, prefix + func_sig(d) + " ")
    gen_braced(cg, 0, d.body)
    cg_out(cg, "\n\n")
}

// top-level code = main (a dll has none)
void gen_main(Codegen* cg, Program prog) {
    if !cg.no_main {
        cg_out(cg, "int main(int strata_argc_, char** strata_argv_) {\n")
        cg_out(cg, "    strata_set_args(strata_argc_, strata_argv_);\n")
        for i in 0..prog.main.len { gen_stmt(cg, 1, prog.main[i]); }
        cg_out(cg, "    return 0;\n}\n")
    }
}

// ---- the whole program as ONE C file ------------------------------------------------

export string generate(Codegen* cg, Program prog) {
    cg_out(cg, "// Generated by stratac. Do not edit.\n")
    // A Strata program is (by default) ONE C file, so single-header C libraries may
    // compile their implementation here when they see this (e.g. lib/crossplatform.h).
    cg_out(cg, "#define STRATA_PROGRAM 1\n")
    gen_includes(cg, prog)
    gen_types(cg, prog)

    // forward declarations (so functions can call each other / recurse)
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if (d.kind == DcFunc) { cg_out(cg, export_prefix(cg, d) + func_sig(d) + ";\n"); }
    }
    cg_out(cg, "\n")

    // definitions
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if (d.kind == DcFunc) { gen_function(cg, d, export_prefix(cg, d)) }
    }
    gen_main(cg, prog)
    return join_pieces(cg.parts)
}

// ---- the program as one C file PER MODULE (split builds) -----------------------------
// A shared header holds what every file needs: the runtime and C includes and every type.
// Each module's file includes it, declares the exported functions of the modules it can
// see (its imports, and what they re-export) plus its own, declares its private functions
// `static`, and defines its functions. The main module's file also holds main() and the
// runtime's state (STRATA_MAIN_TU) and compiles single-header C libraries' implementations
// (STRATA_PROGRAM).
//
// So a module's file changes only when its own code, or an export it can SEE, changes:
// editing a function body recompiles one file; changing an export recompiles the files
// that import it. (A type change touches the header, so everything recompiles.)

export struct SplitOutput {
    string          header      // the shared header's text
    string[dynamic] names       // per C file: its file name
    string[dynamic] units       // per C file: its text
}

// "gfx.Renderer" (module 3) -> "m3_gfx_Renderer.c"
string unit_name(int m, string name) {
    string r = "m" + int_to_str(m) + "_"
    int n = name.len
    for i in 0..n {
        char ch = name[i]
        if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') { r = r + substr(name, i, 1) }
        else { r = r + "_" }
    }
    return r + ".c"
}

export SplitOutput generate_split(Codegen* cg, Program prog, string header_name, string guard) {
    // the shared header
    cg.parts = no_parts()
    cg_out(cg, "// Generated by stratac. Do not edit.\n")
    cg_out(cg, "#ifndef " + guard + "\n#define " + guard + "\n")
    cg_out(cg, "#define STRATA_SPLIT 1\n")
    gen_includes(cg, prog)
    gen_types(cg, prog)
    cg_out(cg, "#endif\n")
    string header = join_pieces(cg.parts)

    string[dynamic] names = []
    string[dynamic] units = []
    for m in 0..prog.modules.len {
        bool any = m == 0   // the main module's file always exists: it holds main() and the runtime state
        for i in 0..prog.decls.len { if prog.decls[i].module == m && prog.decls[i].kind == DcFunc { any = true } }
        if any {
            cg.parts = no_parts()
            cg_out(cg, "// Generated by stratac from " + prog.modules[m].file + ". Do not edit.\n")
            if m == 0 { cg_out(cg, "#define STRATA_MAIN_TU 1\n#define STRATA_PROGRAM 1\n") }
            cg_out(cg, "#include \"" + header_name + "\"\n\n")
            // exported functions this module can call: its own and those of modules it sees
            for i in 0..prog.decls.len {
                Decl* d = prog.decls[i]
                if d.kind == DcFunc && d.is_exported && (d.module == m || module_sees(prog, m, d.module)) {
                    cg_out(cg, export_prefix(cg, d) + func_sig(d) + ";\n")
                }
            }
            for i in 0..prog.decls.len {
                Decl* d = prog.decls[i]
                if d.module == m && d.kind == DcFunc && !d.is_exported { cg_out(cg, "static " + func_sig(d) + ";\n") }
            }
            cg_out(cg, "\n")
            for i in 0..prog.decls.len {
                Decl* d = prog.decls[i]
                if d.module == m && d.kind == DcFunc {
                    if d.is_exported { gen_function(cg, d, export_prefix(cg, d)) }
                    else { gen_function(cg, d, "static ") }
                }
            }
            if m == 0 { gen_main(cg, prog) }
            names.push(unit_name(m, prog.modules[m].name))
            units.push(join_pieces(cg.parts))
        }
    }
    return SplitOutput{ header, names, units }
}

// Can module m see module v's exports? (The checker filled in Module.visible.)
bool module_sees(Program prog, int m, int v) {
    Module mod = prog.modules[m]
    for i in 0..mod.visible.len { if mod.visible[i] == v { return true } }
    return false
}

string[dynamic] no_parts() {
    string[dynamic] p = []
    return p
}

// ---- a dll's C header ------------------------------------------------------------

bool header_uses_math(TypeNode* t) {
    if t == null { return false }
    if t.kind != TyNamed { return header_uses_math(t.elem) }
    return t.name == "vec2" || t.name == "vec3" || t.name == "vec4" || t.name == "mat4" || t.name == "quat"
}
bool header_uses_array(TypeNode* t) {
    if t == null { return false }
    if t.kind == TyDynArray { return true }
    return header_uses_array(t.elem)
}

// The C header for a dll: the entry module's exported enums, structs and functions,
// which is everything a host (e.g. an engine) needs to call it. `guard` names the
// include guard; `source` goes in the comment.
export string generate_header(Program prog, string guard, string source) {
    string[dynamic] out = []
    out.push("/* Generated by stratac from " + source + ". Do not edit. */\n")
    out.push("#ifndef " + guard + "\n#define " + guard + "\n\n#include <stdint.h>\n#include <stdbool.h>\n")

    // types from the Strata runtime, only if an exported signature uses them
    bool math = false
    bool arrays = false
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if d.module == 0 && d.is_exported {
            if d.kind == DcFunc {
                math = math || header_uses_math(d.ret)
                arrays = arrays || header_uses_array(d.ret)
                for p in 0..d.params.len {
                    math = math || header_uses_math(d.params[p].type)
                    arrays = arrays || header_uses_array(d.params[p].type)
                }
            }
            if d.kind == DcStruct {
                for f in 0..d.fields.len {
                    math = math || header_uses_math(d.fields[f].type)
                    arrays = arrays || header_uses_array(d.fields[f].type)
                }
            }
        }
    }
    if math   { out.push("#include <smath.h>   /* vec2/3/4, mat4, quat: from Strata's lib/ */\n") }
    if arrays { out.push("#include <sarr.h>    /* Array (T[dynamic]): from Strata's lib/ */\n") }
    out.push("\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n")

    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if d.module == 0 && d.is_exported && d.kind == DcEnum {
            string e = "typedef enum {"
            for m in 0..d.members.len { if m > 0 { e = e + "," } e = e + " " + d.members[m] }
            out.push(e + " } " + d.name + ";\n")
        }
    }
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if d.module == 0 && d.is_exported && d.kind == DcStruct {
            out.push("typedef struct " + d.name + " " + d.name + ";\n")
            string st = "struct " + d.name + " {\n"
            for f in 0..d.fields.len { st = st + "    " + ty_to_c(d.fields[f].type) + " " + d.fields[f].name + ";\n" }
            out.push(st + "};\n")
        }
    }
    out.push("\n")
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if d.module == 0 && d.is_exported && d.kind == DcFunc { out.push(func_sig(d) + ";\n") }
    }
    out.push("\n#ifdef __cplusplus\n}\n#endif\n\n#endif /* " + guard + " */\n")
    return join_pieces(out)
}
