// src/console.dmm - the Strata explorer console (front-end #2).
//
// A SECOND, independent executable built on the exact same core (core.dmm) and the
// same renderer (dump.dmm) as the `strata` CLI. Its only job is to prove the point of
// the architecture: the compiler is a reusable library, and a front-end is a thin
// shell over it. This one shows a file's tokens AND its AST together in one view - a
// tiny "compiler explorer" for eyeballing what the core produced.
//
//   console <file.strata>

#include "dump.dmm"   // print_tokens / print_program (+ the core)

int main(str[] args) {
    if (args.len < 2) {
        print("strata console - show a program's tokens and AST");
        print("usage: console <file.strata>");
        return 2;
    }
    str path = args[1];
    str src  = read_file(path);

    print("=== TOKENS ===");
    Token[] toks = lex(src);
    print_tokens(toks);

    print("");
    print("=== AST ===");
    Parser p = Parser{ toks, 0, false, false };
    Program prog = parse_program(&p);
    if (p.had_error) { print("(parse error)"); return 1; }
    print_program(prog);
    return 0;
}
