// src/ast.hmm - the Strata AST. Part of the compiler CORE (no main; reused by every
// front-end). Follows D--'s "kind tag + fat struct + new_* constructor" style
// (ARCHITECTURE.md sec 4: the AST is the spine, traversed by switch on `kind`).
//
// Strata-specific vs D--'s AST:
//   * no ExNew/ExCast/ExSizeof, no StSwitch (those features aren't designed yet);
//   * StForIn replaces C-style StFor: `for name in iter { }`;
//   * `..` ranges are ExBinary with op "..";
//   * Program carries top-level statements (`main`) as well as decls, because
//     top-level code = the entry point (DESIGN sec 2).

// ---- types -------------------------------------------------------------

enum TypeKind { TyNamed, TyArray, TyFixedArray, TyPointer }

struct TypeNode {
    TypeKind  kind;
    str       name;    // TyNamed: "int", "vec3", "Entity", ...
    TypeNode* elem;    // element type (Array / FixedArray / Pointer)
    str       size;    // TyFixedArray: N as written
    int       line;
    int       col;
}

TypeNode* new_type(TypeKind k, int line, int col) {
    return new TypeNode{ k, "", null, "", line, col };
}

// ---- expressions -------------------------------------------------------

enum ExprKind {
    ExIntLit, ExFloatLit, ExStringLit, ExCharLit, ExBoolLit,
    ExName, ExUnary, ExBinary, ExCall, ExField, ExIndex,
    ExArrayLit, ExStructLit
}

struct Expr {
    ExprKind  kind;
    int       line;
    int       col;
    str       text;       // Int/Float raw text; String/Char decoded; Name id; Unary/Binary op
    str       field;      // ExField: member name
    str       type_name;  // ExStructLit: struct name
    bool      bval;       // ExBoolLit value
    Expr*     a;          // Unary operand / Binary lhs / Call callee / Field obj / Index obj
    Expr*     b;          // Binary rhs / Index index
    Expr*[]   items;      // Call args / ArrayLit elems / StructLit args
    TypeNode* rtype;      // resolved type, filled by the checker (null until then)
}

Expr* new_expr(ExprKind k, int line, int col) {
    Expr*[] items = [];
    return new Expr{ k, line, col, "", "", "", false, null, null, items, null };
}

// ---- statements --------------------------------------------------------

enum StmtKind {
    StBlock, StVar, StReturn, StExprStmt, StAssign,
    StIf, StWhile, StForIn, StRegion
}

struct Stmt {
    StmtKind kind;
    int      line;
    int      col;
    // StVar
    bool       is_const;
    str        name;        // StVar name / StForIn loop var / StRegion region name ("" = anon)
    TypeNode*  type;        // StVar: null => inferred (`var`)
    Expr*      init;        // StVar initializer (optional)
    // StReturn value / StExprStmt expr
    Expr*      expr;
    // StAssign
    Expr*      target;
    str        op;          // "=", "+=", ...
    Expr*      value;
    // StIf / StWhile condition
    Expr*      cond;
    // StForIn iterable
    Expr*      iter;
    // StIf
    Stmt*      then_block;
    Stmt*      else_branch; // Block or StIf, or null
    // StWhile / StForIn / StRegion body
    Stmt*      body;
    // StBlock
    Stmt*[]    stmts;
}

Stmt* new_stmt(StmtKind k, int line, int col) {
    Stmt*[] stmts = [];
    return new Stmt{
        k, line, col,
        false, "", null, null,   // is_const, name, type, init
        null,                     // expr
        null, "", null,           // target, op, value
        null,                     // cond
        null,                     // iter
        null, null,               // then_block, else_branch
        null,                     // body
        stmts                     // stmts
    };
}

// ---- declarations ------------------------------------------------------

enum DeclKind { DcFunc, DcStruct, DcEnum }

struct Param    { str name; TypeNode* type; }
struct FieldDef { str name; TypeNode* type; }

struct Decl {
    DeclKind kind;
    int      line;
    int      col;
    str      name;         // DcFunc / DcStruct / DcEnum
    // DcFunc
    Param[]    params;
    TypeNode*  ret;
    Stmt*      body;
    // DcStruct
    FieldDef[] fields;
    // DcEnum
    str[]      members;
}

Decl* new_decl(DeclKind k, int line, int col) {
    Param[]    params  = [];
    FieldDef[] fields  = [];
    str[]      members = [];
    return new Decl{
        k, line, col,
        "",                      // name
        params, null, null,      // params, ret, body
        fields,                  // fields
        members                  // members
    };
}

// Program = the top-level decls (struct/enum/func) plus the top-level statement
// sequence that becomes the implicit `main`.
struct Program { Decl*[] decls; Stmt*[] main; }
