// src/stratac.strata - the Strata compiler driver (front-end #1: the CLI, `stratac`).
// Thin: CLI + orchestration only (ARCHITECTURE.md rule #4). Pulls in the shared
// renderer (dump.strata), which pulls in the whole core (incl. codegen).
//
//   stratac tokens <file.strata>   print the token stream
//   stratac ast    <file.strata>   parse and print the AST
//   stratac emit   <file.strata>   print the generated C
//   stratac build  <file.strata>   compile to a native executable
//   stratac run    <file.strata>   compile and run

import core   // the compiler (every phase, re-exported)
import dump   // print_tokens / print_program
import project   // strata.toml
import build     // the build pipeline + cache
import <stdlib.h>   // system()  (C header, passed through to the generated C)

string stratac_version() { return "1.2.0 (projects)"; }

// ---- paths -------------------------------------------------------------
// (stem_of / basename_of / dirname_of live in the core's module loader)

bool file_exists(string p) { return read_file(p).len > 0; }

// Find the runtime lib/ (arena.h, ...) relative to the stratac executable.
string resolve_libdir(string argv0) {
    string dir = dirname_of(argv0)
    if (file_exists(dir + "/lib/arena.h"))    { return dir + "/lib"; }
    if (file_exists(dir + "/../lib/arena.h")) { return dir + "/../lib"; }
    if (file_exists("lib/arena.h"))           { return "lib"; }
    if (file_exists("../lib/arena.h"))        { return "../lib"; }
    return dir + "/lib"
}

// ---- pipeline helpers --------------------------------------------------

int cmd_tokens(string path) {
    print_tokens(lex(read_file(path)))
    return 0
}

// `ast` shows ONE file as parsed (imports appear as nodes; nothing is loaded).
int cmd_ast(string path) {
    Parser p = new_parser(lex(read_file(path)))
    Program prog = parse_program(&p)
    if p.had_error {
        print(basename_of(path) + ":" + int_to_str(p.err_line) + ":" + int_to_str(p.err_col) + ": parse error: " + p.err_msg)
        return 1
    }
    print_program(prog)
    return 0
}

int cmd_check(string path) {
    LoadResult lr = load_program(path)
    if (!lr.ok) { return 1; }
    Program prog = lr.prog
    Checker* ck = new_checker(basename_of(path))
    ck_check(ck, prog)
    if (ck.had_error) { return 1; }
    print("no type errors")
    return 0
}

int cmd_emit(string path) {
    LoadResult lr = load_program(path)
    if (!lr.ok) { return 1; }
    Program prog = lr.prog
    Checker* ck = new_checker(basename_of(path))
    ck_check(ck, prog)
    if (ck.had_error) { return 1; }
    Codegen cg = new_codegen()
    string out = generate(&cg, prog)
    if (cg.had_error) { print("codegen: program uses features not supported yet"); return 1; }
    printf(cstr("%s"), cstr(out))// verbatim, like fputs
    return 0
}

// ---- targets --------------------------------------------------------------
// What a command works on: a single .strata file, or a project (a strata.toml, a folder
// containing one, or - with no argument - the current folder).

struct Target { bool ok; bool is_project; string file; Project proj }

bool ends_with(string s, string suffix) {
    return s.len >= suffix.len && substr(s, s.len - suffix.len, suffix.len) == suffix
}

Target resolve_target(string arg) {
    Project none = load_project_none()
    if ends_with(arg, ".strata") || ends_with(arg, ".str") {
        return Target{ true, false, arg, none }
    }
    string toml = "strata.toml"
    if ends_with(arg, "strata.toml") { toml = arg }
    else if arg != "" { toml = arg + "/strata.toml" }
    if !file_exists(toml) {
        if arg == "" { print("error: no strata.toml in this folder (pass a .strata file or a project folder, or create one with 'stratac new <name>')") }
        else { print("error: no strata.toml in " + arg) }
        return Target{ false, false, "", none }
    }
    Project p = load_project(toml)
    return Target{ p.ok, true, p.root + "/" + p.entry, p }
}

// An empty Project for targets that aren't one.
Project load_project_none() {
    string[dynamic] e = []
    return Project{ false, "", "", "", "", "", "", "", false, e, e, e, e, e, e }
}

BuildSpec target_spec(Target t, bool release, bool force, bool quiet) {
    if t.is_project { return spec_for_project(t.proj, stratac_version(), release, force, quiet) }
    return spec_for_file(t.file, stratac_version(), quiet)
}

// ---- build / run / new --------------------------------------------------------

int cmd_build(Target t, string libdir, bool release, bool force) {
    if run_build(target_spec(t, release, force, false), libdir) { return 0 }
    return 1
}

int cmd_run(Target t, string libdir, bool release, bool force, string[dynamic] prog_args) {
    BuildSpec spec = target_spec(t, release, force, true)
    if spec.dll { print("error: this project builds a dll; there's nothing to run"); return 1 }
    if !run_build(spec, libdir) { return 1 }
    string exe = win_path(spec.out_bin)
    // a bare `prog.exe` is not found when the shell doesn't search the current dir
    if (dirname_of(exe) == ".") { exe = ".\\" + exe; }
    string runcmd = "\"" + exe + "\""
    for i in 0..prog_args.len { runcmd = runcmd + " \"" + prog_args[i] + "\"" }
    runcmd = "\"" + runcmd + "\""// cmd.exe strips the outer quote pair
    return system(cstr(runcmd))
}

// stratac new <name>: a project folder with a strata.toml and src/main.strata
int cmd_new(string name) {
    if file_exists(name + "/strata.toml") { print("error: " + name + "/strata.toml already exists"); return 1 }
    system(cstr("if not exist \"" + win_path(name + "/src") + "\" mkdir \"" + win_path(name + "/src") + "\""))
    string pname = basename_of(name)
    string toml = "# " + pname + " - a Strata project. Build: stratac build   Run: stratac run\n" +
                  "[project]\n" +
                  "name    = \"" + pname + "\"\n" +
                  "version = \"0.1.0\"\n" +
                  "entry   = \"src/main.strata\"\n" +
                  "output  = \"exe\"          # or \"dll\"\n" +
                  "\n" +
                  "[build]\n" +
                  "libs = []                # C libraries for every platform, e.g. [\"raylib\"]\n" +
                  "\n" +
                  "[windows]\n" +
                  "libs = []                # e.g. [\"user32\"]\n" +
                  "\n" +
                  "[linux]\n" +
                  "libs = []                # e.g. [\"X11\"]\n"
    bool ok = write_file(name + "/strata.toml", toml)
    ok = ok && write_file(name + "/src/main.strata", "// " + pname + " - the entry point. Other files in this folder are modules: `import name`.\nprint(\"hello from " + pname + "\")\n")
    ok = ok && write_file(name + "/.gitignore", "build/\n")
    if !ok { print("error: could not write the project files in " + name); return 1 }
    print("created " + name + "/strata.toml and " + name + "/src/main.strata")
    print("next:  cd " + name + "  then  stratac run")
    return 0
}

int usage() {
    print("stratac - the Strata compiler")
    print("usage:")
    print("  stratac new    <name>            create a project (strata.toml + src/main.strata)")
    print("  stratac run    [target] [--release] [--force] [-- args]   build and run")
    print("  stratac build  [target] [--release] [--force]             build an exe or dll")
    print("  stratac check  [target]          type-check only")
    print("  stratac emit   [target]          print the generated C")
    print("  stratac ast    <file.strata>     parse and print the AST")
    print("  stratac tokens <file.strata>     print the token stream")
    print("")
    print("target: a .strata file, a project folder, a strata.toml, or nothing (the project")
    print("in the current folder). Projects are cached: unchanged builds skip the C compiler.")
    return 2
}

int dmm_main(string[dynamic] args) {
    if (args.len == 2 && (args[1] == "version" || args[1] == "--version")) {
        print("stratac " + stratac_version() + " - the Strata compiler")
        return 0
    }
    if (args.len < 2) { return usage(); }

    // stratac <cmd> [target] [--release] [--force] [program args...] [-- program args...]
    string cmd = args[1]
    string target = ""
    bool have_target = false
    bool release = false
    bool force = false
    bool rest_mode = false
    string[dynamic] prog_args = []
    for i in 2..args.len {
        string a = args[i]
        if rest_mode { prog_args.push(a) }
        else if a == "--" { rest_mode = true }
        else if a == "--release" { release = true }
        else if a == "--force" { force = true }
        else if !have_target { target = a; have_target = true }
        else { prog_args.push(a) }
    }
    string libdir = resolve_libdir(args[0])

    if cmd == "new" {
        if !have_target { print("usage: stratac new <name>"); return 2 }
        return cmd_new(target)
    }
    if cmd == "tokens" || cmd == "ast" {
        if !have_target { return usage() }
        if cmd == "tokens" { return cmd_tokens(target) }
        return cmd_ast(target)
    }
    if cmd != "check" && cmd != "emit" && cmd != "build" && cmd != "run" { return usage() }

    Target t = resolve_target(target)
    if !t.ok { return 1 }
    if cmd == "check" { return cmd_check(t.file) }
    if cmd == "emit"  { return cmd_emit(t.file) }
    if cmd == "build" { return cmd_build(t, libdir, release, force) }
    return cmd_run(t, libdir, release, force, prog_args)
}

// entry point (translated from D--'s `int main(str[] args)`)
import <stdlib.h>
exit(dmm_main(args()))
