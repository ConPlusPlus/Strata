//
// src/build.strata - the build pipeline: Strata source -> C -> a native exe or dll.
// Part of the build system (on top of the compiler core; front-ends call it).
//
// A BuildSpec says what to build and how. A single .strata file gets the classic spec
// (output next to the source, -O2, no cache); a project (strata.toml) gets its settings
// from the project file, output in its out_dir, and a CACHE: a fingerprint of everything
// that affects the binary (generated C, the gcc command, extra C sources, the compiler
// version). If it matches the last successful build and the binary is still there, gcc
// is skipped ("up to date").
//
// Known gap: C headers the program includes (`import "x.h"`) aren't part of the
// fingerprint; `--force` rebuilds regardless.

import core
import project
import <stdlib.h>   // system()
import "strata_host.h"   // strata_report: where messages go (see strata_host.h)

export struct BuildSpec {
    string entry            // the root .strata file
    string out_c            // where the generated C goes
    string out_bin          // the exe / dll
    bool   dll
    bool   release          // -O2 (else -O0 -g)
    string[dynamic] defines
    string[dynamic] include_dirs
    string[dynamic] lib_dirs
    string[dynamic] libs
    string[dynamic] c_sources
    string[dynamic] frameworks
    string cache_file       // "" = no cache
    bool   force            // ignore the cache
    bool   quiet            // don't print "built ..." / "up to date ..."
    string tool_version     // part of the fingerprint: a new compiler rebuilds everything
}

string[dynamic] no_strings() {
    string[dynamic] a = []
    return a
}

// The classic single-file build: foo.strata -> foo.c + foo.exe beside it.
export BuildSpec spec_for_file(string path, string version, bool quiet) {
    string stem = stem_of(path)
    return BuildSpec{ path, stem + ".c", stem + ".exe", false, true,
                      no_strings(), no_strings(), no_strings(), no_strings(), no_strings(), no_strings(),
                      "", false, quiet, version }
}

// A project build: paths in the project file are relative to its folder.
export BuildSpec spec_for_project(Project p, string version, bool release, bool force, bool quiet) {
    string root = p.root
    string out = root + "/" + p.out_dir
    string ext = ".exe"
    if p.output == "dll" { ext = ".dll" }
    BuildSpec s = BuildSpec{ root + "/" + p.entry, out + "/" + p.name + ".c", out + "/" + p.name + ext,
                             p.output == "dll", release || p.release,
                             p.defines, no_strings(), no_strings(), p.libs, no_strings(), p.frameworks,
                             out + "/.strata-cache", force, quiet, version }
    for i in 0..p.include_dirs.len { s.include_dirs.push(root + "/" + p.include_dirs[i]) }
    for i in 0..p.lib_dirs.len     { s.lib_dirs.push(root + "/" + p.lib_dirs[i]) }
    for i in 0..p.c_sources.len    { s.c_sources.push(root + "/" + p.c_sources[i]) }
    return s
}

// ---- helpers ----------------------------------------------------------------

// Windows paths for cmd.exe (it treats `/` as a switch in some commands)
export string win_path(string p) {
    string r = ""
    int n = p.len
    for i in 0..n {
        if p[i] == '/' { r = r + "\\" } else { r = r + substr(p, i, 1) }
    }
    return r
}

string quoted(string s) { return "\"" + s + "\"" }

// FNV-1a over the text, as a decimal string. (The length is read once: `.len` is O(n).)
string fingerprint(string s) {
    u64 h = 1469598103934665603
    int n = s.len
    for i in 0..n {
        h = h ^ cast<u64>(cast<u8>(s[i]))
        h = h * 1099511628211
    }
    return int_to_str(cast<int>(h))
}

bool file_present(string p) { return read_file(p).len > 0 }

// "mathlib" -> "MATHLIB_H": an include guard from a file name
string guard_for(string name) {
    string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    string lower = "abcdefghijklmnopqrstuvwxyz"
    string g = ""
    int n = name.len
    for i in 0..n {
        char c = name[i]
        if c >= 'a' && c <= 'z' { g = g + substr(upper, cast<int>(c) - cast<int>('a'), 1) }
        else if (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') { g = g + substr(name, i, 1) }
        else { g = g + "_" }
    }
    return g + "_H"
}

// ---- the pipeline -------------------------------------------------------------

// Build per `s`, using the runtime headers in `libdir`. Prints errors; returns success.
export bool run_build(BuildSpec s, string libdir) {
    LoadResult lr = load_program(s.entry)
    if !lr.ok { return false }
    Program prog = lr.prog
    Checker* ck = new_checker(basename_of(s.entry))
    ck_check(ck, prog)
    if ck.had_error { return false }
    if s.dll && prog.main.len > 0 {
        Stmt* st = prog.main[0]
        strata_report(basename_of(s.entry) + ":" + int_to_str(st.line) + ":" + int_to_str(st.col) +
              ": error: a dll has no main, so its entry file can't contain top-level code")
        return false
    }
    Codegen cg = new_codegen()
    cg.no_main = s.dll
    string c = generate(&cg, prog)
    if cg.had_error { strata_report("codegen: program uses features not supported yet"); return false }

    // the gcc command
    string opt = " -O0 -g"
    if s.release { opt = " -O2" }
    string cmd = "gcc -std=gnu11" + opt + " " + quoted(s.out_c)
    for i in 0..s.c_sources.len    { cmd = cmd + " " + quoted(s.c_sources[i]) }
    cmd = cmd + " -I" + quoted(libdir)
    for i in 0..s.include_dirs.len { cmd = cmd + " -I" + quoted(s.include_dirs[i]) }
    for i in 0..s.defines.len      { cmd = cmd + " -D" + quoted(s.defines[i]) }
    for i in 0..s.lib_dirs.len     { cmd = cmd + " -L" + quoted(s.lib_dirs[i]) }
    for i in 0..prog.decls.len {   // `link "..."` directives in the source
        if prog.decls[i].kind == DcLink { cmd = cmd + " -l" + prog.decls[i].path }
    }
    for i in 0..s.libs.len         { cmd = cmd + " -l" + s.libs[i] }
    for i in 0..s.frameworks.len   { cmd = cmd + " -framework " + s.frameworks[i] }
    if s.dll { cmd = cmd + " -shared -Wl,--out-implib," + quoted(stem_of(s.out_bin) + ".dll.a") }
    cmd = cmd + " -o " + quoted(s.out_bin) + " -lm"

    // a dll gets a C header declaring its entry points (kept current even on a cache hit)
    string header = ""
    if s.dll { header = generate_header(prog, guard_for(basename_of(stem_of(s.out_bin))), basename_of(s.entry)) }

    // the cache: skip gcc if nothing that affects the binary changed
    string key = ""
    if s.cache_file != "" {
        string all = c + "\n" + cmd + "\n" + s.tool_version
        for i in 0..s.c_sources.len { all = all + "\n" + read_file(s.c_sources[i]) }
        key = fingerprint(all)
        if !s.force && read_file(s.cache_file) == key && file_present(s.out_bin) {
            if s.dll && read_file(stem_of(s.out_bin) + ".h") != header { write_file(stem_of(s.out_bin) + ".h", header) }
            if !s.quiet { strata_report("up to date: " + s.out_bin) }
            return true
        }
        string dir = dirname_of(s.out_c)
        if dir != "." { system(cstr("if not exist " + quoted(win_path(dir)) + " mkdir " + quoted(win_path(dir)))) }
    }

    write_file(s.out_c, c)
    if s.dll { write_file(stem_of(s.out_bin) + ".h", header) }
    int rc = system(cstr(cmd))
    if rc != 0 { return false }
    if s.cache_file != "" { write_file(s.cache_file, key) }
    if !s.quiet { strata_report("built " + s.out_bin) }
    return true
}

// ---- targets --------------------------------------------------------------
// What a command works on: a single .strata file, or a project (a strata.toml, a folder
// containing one, or - given "" - the current folder).

export struct Target { bool ok; bool is_project; string file; Project proj }

bool ends_with(string s, string suffix) {
    return s.len >= suffix.len && substr(s, s.len - suffix.len, suffix.len) == suffix
}

// An empty Project for targets that aren't one.
Project no_project() {
    string[dynamic] e = []
    return Project{ false, "", "", "", "", "", "", "", false, e, e, e, e, e, e }
}

export Target resolve_target(string arg) {
    if ends_with(arg, ".strata") || ends_with(arg, ".str") {
        return Target{ true, false, arg, no_project() }
    }
    string toml = "strata.toml"
    if ends_with(arg, "strata.toml") { toml = arg }
    else if arg != "" { toml = arg + "/strata.toml" }
    if !file_present(toml) {
        if arg == "" { strata_report("error: no strata.toml in this folder (pass a .strata file or a project folder, or create one with 'stratac new <name>')") }
        else { strata_report("error: no strata.toml in " + arg) }
        return Target{ false, false, "", no_project() }
    }
    Project p = load_project(toml)
    return Target{ p.ok, true, p.root + "/" + p.entry, p }
}

export BuildSpec target_spec(Target t, string version, bool release, bool force, bool quiet) {
    if t.is_project { return spec_for_project(t.proj, version, release, force, quiet) }
    return spec_for_file(t.file, version, quiet)
}
