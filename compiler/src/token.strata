//
// src/token.strata - token kinds + the Token record, shared across the Strata compiler
// modules (the lexer produces them, the parser consumes them).
//
// Strata differs from D-- in a few token-level ways, all reflected here:
//   * NO `func` keyword and NO `->` : declarations are types-first (`vec3 update(...)`).
//   * primitive type names (`int`, `float`, `vec3`, `void`, ...) are plain identifiers,
//     not keywords - the checker knows them, the lexer does not.
//   * `..`  : the range operator, for `for i in 0..n`.
//   * NEWLINE is a real token : Strata terminates statements with newlines, not `;`
//     (the lexer only emits one where a statement can actually end - see lexer.strata).
//
// Only keywords/operators for features that are DESIGNED are included. Undecided ones
// (match/switch, foreign, defer, null, import, #soa ...) are added when their feature is.

export enum TokKind {
    TkIdent, TkInt, TkFloat, TkString, TkChar,
    TkKwVar, TkKwConst, TkKwStruct, TkKwEnum,
    TkKwIf, TkKwElse, TkKwWhile, TkKwFor, TkKwIn, TkKwReturn,
    TkKwTrue, TkKwFalse, TkKwRegion, TkKwImport, TkKwLink,
    TkKwSwitch, TkKwCase, TkKwDefault, TkKwExport,
    TkKwCast, TkKwSizeof,
    TkLParen, TkRParen, TkLBrace, TkRBrace, TkLBracket, TkRBracket,
    TkComma, TkSemicolon, TkColon, TkDot, TkDotDot, TkHash,
    TkAssign, TkPlus, TkMinus, TkStar, TkSlash, TkPercent,
    TkPlusEq, TkMinusEq, TkStarEq, TkSlashEq,
    TkEqEq, TkBangEq, TkLt, TkLtEq, TkGt, TkGtEq,
    TkAmpAmp, TkPipePipe, TkBang, TkAmp,
    TkPipe, TkCaret, TkTilde, TkShl, TkShr,
    TkPipeEq, TkAmpEq, TkCaretEq, TkShlEq, TkShrEq,
    TkNewline,
    TkEof, TkError
}

export struct Token {
    TokKind kind
    string     text// source lexeme (Ident/Int/Float) or decoded value (String/Char)
    i32     line
    i32     col
}
