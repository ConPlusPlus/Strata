//
// src/parser.dmm - the Strata parser, written in D-- (a MODULE, no main). CORE.
//
// Milestone 1, step 2. Recursive descent: Token[] -> ast.hmm nodes. Included by the
// core; front-ends print the tree via `strata ast`.
//
// Strata grammar vs D--'s parser:
//   * statements are terminated by NEWLINE (or `}` / EOF), not `;`. The block/program
//     loops skip_newlines between items; statements don't consume a terminator.
//   * control flow has NO parens: `if cond { }`, `while cond { }`, `for x in iter { }`.
//     To keep `{` unambiguous there, a `no_brace` flag disables bare struct literals
//     while parsing a condition/iterable (the rule Go and Rust use). Brackets `(` `[`
//     re-enable them for their inner expressions.
//   * `..` is a range operator (loosest expression precedence), for `for i in 0..n`.
//   * top-level items are struct/enum/function decls OR statements (-> implicit main).

#include "lexer.dmm"   // lex() + Token/TokKind (via token.hmm)
#include "ast.hmm"     // the AST node types + new_* constructors

struct Parser {
    Token[] toks;
    int     pos;
    bool    had_error;
    bool    no_brace;   // when true, `Ident {` is NOT a struct literal (control headers)
}

// ---- cursor ------------------------------------------------------------

Token p_peek(Parser* p) { return p.toks[p.pos]; }
Token p_peek_at(Parser* p, int off) {
    int i = p.pos + off;
    if (i < p.toks.len) { return p.toks[i]; }
    return p.toks[p.toks.len - 1];   // Eof
}
Token p_prev(Parser* p) { return p.toks[p.pos - 1]; }
bool  p_at_end(Parser* p) { return p_peek(p).kind == TkEof; }
bool  p_check(Parser* p, TokKind k) { return p_peek(p).kind == k; }

Token p_advance(Parser* p) {
    if (!p_at_end(p)) { p.pos += 1; }
    return p_prev(p);
}
bool p_match(Parser* p, TokKind k) {
    if (p_check(p, k)) { p_advance(p); return true; }
    return false;
}
Token p_expect(Parser* p, TokKind k) {
    if (p_check(p, k)) { return p_advance(p); }
    p.had_error = true;
    return p_peek(p);
}
void skip_newlines(Parser* p) {
    while (p_check(p, TkNewline)) { p_advance(p); }
}

// ---- types -------------------------------------------------------------
// A type is a name followed by any run of `*` (pointer) and `[]`/`[N]` (array),
// left-to-right: `Entity*`, `int[]`, `int[64]`, `vec3`.

TypeNode* parse_type(Parser* p) {
    Token nt = p_peek(p);
    TypeNode* t = new_type(TyNamed, nt.line, nt.col);
    t.name = p_expect(p, TkIdent).text;
    while (p_check(p, TkLBracket) || p_check(p, TkStar)) {
        if (p_check(p, TkLBracket)) {
            p_advance(p);
            TypeNode* arr = new_type(TyArray, t.line, t.col);
            if (p_check(p, TkIdent) && p_peek(p).text == "dynamic") {
                p_advance(p);
                arr.kind = TyDynArray;
            } else if (p_check(p, TkInt)) {
                arr.kind = TyFixedArray;
                arr.size = p_advance(p).text;
            }
            p_expect(p, TkRBracket);
            arr.elem = t;
            t = arr;
        } else {
            p_advance(p);
            TypeNode* ptr = new_type(TyPointer, t.line, t.col);
            ptr.elem = t;
            t = ptr;
        }
    }
    return t;
}

// ---- lookahead ---------------------------------------------------------
// Skip a type starting at token index i; return the index just past it, or -1 if
// there is no type there.
int skip_type_at(Parser* p, int i) {
    if (p.toks[i].kind != TkIdent) { return 0 - 1; }
    i += 1;
    while (p.toks[i].kind == TkLBracket || p.toks[i].kind == TkStar) {
        if (p.toks[i].kind == TkStar) { i += 1; }
        else {
            i += 1;
            if (p.toks[i].kind == TkInt) { i += 1; }
            else if (p.toks[i].kind == TkIdent && p.toks[i].text == "dynamic") { i += 1; }
            if (p.toks[i].kind != TkRBracket) { return 0 - 1; }
            i += 1;
        }
    }
    return i;
}

// `Type name ...` in statement position => a typed variable declaration.
bool looks_like_typed_decl(Parser* p) {
    int i = skip_type_at(p, p.pos);
    if (i < 0) { return false; }
    return p.toks[i].kind == TkIdent;
}

// `Type name (` at top level => a function declaration.
bool looks_like_func(Parser* p) {
    int i = skip_type_at(p, p.pos);
    if (i < 0) { return false; }
    if (p.toks[i].kind != TkIdent) { return false; }   // function name
    i += 1;
    return p.toks[i].kind == TkLParen;
}

// ---- declarations ------------------------------------------------------

// `import "header.h"` or `import <header.h>` - a C header to #include (interop).
Decl* import_decl(Parser* p) {
    Token kw = p_expect(p, TkKwImport);
    Decl* d = new_decl(DcInclude, kw.line, kw.col);
    if (p_check(p, TkString)) {
        d.path = p_advance(p).text;
        d.is_system = false;
    } else if (p_check(p, TkLt)) {
        p_advance(p);
        str path = "";
        while (!p_check(p, TkGt) && !p_at_end(p)) { path = path + p_advance(p).text; }
        p_expect(p, TkGt);
        d.path = path;
        d.is_system = true;
    } else {
        p.had_error = true;
    }
    return d;
}

// `link "raylib"` - a C library to link (adds -lraylib to the build).
Decl* link_decl(Parser* p) {
    Token kw = p_expect(p, TkKwLink);
    Decl* d = new_decl(DcLink, kw.line, kw.col);
    d.path = p_expect(p, TkString).text;   // the library name (path field reused)
    return d;
}

Decl* enum_decl(Parser* p) {
    Token kw = p_expect(p, TkKwEnum);
    Decl* ed = new_decl(DcEnum, kw.line, kw.col);
    ed.name = p_expect(p, TkIdent).text;
    p_expect(p, TkLBrace);
    skip_newlines(p);
    while (!p_check(p, TkRBrace) && !p_at_end(p)) {
        ed.members.push(p_expect(p, TkIdent).text);
        p_match(p, TkComma);       // separators optional (comma and/or newline)
        skip_newlines(p);
    }
    p_expect(p, TkRBrace);
    return ed;
}

Decl* struct_decl(Parser* p) {
    Token kw = p_expect(p, TkKwStruct);
    Decl* sd = new_decl(DcStruct, kw.line, kw.col);
    sd.name = p_expect(p, TkIdent).text;
    p_expect(p, TkLBrace);
    skip_newlines(p);
    while (!p_check(p, TkRBrace) && !p_at_end(p)) {
        TypeNode* fty = parse_type(p);
        str fnm = p_expect(p, TkIdent).text;
        sd.fields.push(FieldDef{ fnm, fty });
        p_match(p, TkSemicolon);   // `;` separator optional
        skip_newlines(p);
    }
    p_expect(p, TkRBrace);
    return sd;
}

Decl* func_decl(Parser* p) {
    Token ft = p_peek(p);
    Decl* fd = new_decl(DcFunc, ft.line, ft.col);
    fd.ret = parse_type(p);
    fd.name = p_expect(p, TkIdent).text;
    p_expect(p, TkLParen);
    skip_newlines(p);
    if (!p_check(p, TkRParen)) {
        bool more = true;
        while (more) {
            TypeNode* pty = parse_type(p);
            str pnm = p_expect(p, TkIdent).text;
            fd.params.push(Param{ pnm, pty });
            more = p_match(p, TkComma);
            skip_newlines(p);
        }
    }
    p_expect(p, TkRParen);
    fd.body = block(p);
    return fd;
}

// ---- program -----------------------------------------------------------

Program parse_program(Parser* p) {
    Decl*[] decls = [];
    Stmt*[] main  = [];
    skip_newlines(p);
    while (!p_at_end(p) && !p.had_error) {
        bool exported = false;
        if (p_check(p, TkKwExport)) { p_advance(p); exported = true; skip_newlines(p); }
        if (p_check(p, TkKwStruct))     { Decl* d = struct_decl(p); d.is_exported = exported; decls.push(d); }
        else if (p_check(p, TkKwEnum))  { Decl* d = enum_decl(p);   d.is_exported = exported; decls.push(d); }
        else if (looks_like_func(p))    { Decl* d = func_decl(p);   d.is_exported = exported; decls.push(d); }
        else if (exported)              { p.had_error = true; p_advance(p); }   // `export` must precede a decl
        else if (p_check(p, TkKwImport)) { decls.push(import_decl(p)); }
        else if (p_check(p, TkKwLink))  { decls.push(link_decl(p)); }
        else {
            int before = p.pos;
            main.push(statement(p));
            if (p.pos == before) { p.had_error = true; p_advance(p); }
        }
        skip_newlines(p);
    }
    return Program{ decls, main };
}

// ---- statements --------------------------------------------------------

Stmt* block(Parser* p) {
    Token lb = p_expect(p, TkLBrace);
    Stmt* b = new_stmt(StBlock, lb.line, lb.col);
    skip_newlines(p);
    while (!p_check(p, TkRBrace) && !p_at_end(p)) {
        int before = p.pos;
        b.stmts.push(statement(p));
        if (p.pos == before) { p.had_error = true; p_advance(p); }
        skip_newlines(p);
    }
    p_expect(p, TkRBrace);
    return b;
}

Stmt* var_decl_core(Parser* p) {
    Token st = p_peek(p);
    Stmt* s = new_stmt(StVar, st.line, st.col);
    if (p_match(p, TkKwConst)) { s.is_const = true; s.type = null; }
    else if (p_match(p, TkKwVar)) { s.type = null; }
    else { s.type = parse_type(p); }
    s.name = p_expect(p, TkIdent).text;
    if (p_match(p, TkAssign)) { s.init = expression(p); }
    return s;
}

Stmt* expr_or_assign_core(Parser* p) {
    Expr* e = expression(p);
    TokKind t = p_peek(p).kind;
    if (t == TkAssign || t == TkPlusEq || t == TkMinusEq || t == TkStarEq || t == TkSlashEq
        || t == TkPipeEq || t == TkAmpEq || t == TkCaretEq || t == TkShlEq || t == TkShrEq) {
        Token op = p_advance(p);
        Stmt* s = new_stmt(StAssign, e.line, e.col);
        s.target = e;
        s.op = op.text;
        s.value = expression(p);
        return s;
    }
    Stmt* s = new_stmt(StExprStmt, e.line, e.col);
    s.expr = e;
    return s;
}

Stmt* return_stmt(Parser* p) {
    Token kw = p_advance(p);
    Stmt* s = new_stmt(StReturn, kw.line, kw.col);
    if (!p_check(p, TkNewline) && !p_check(p, TkRBrace) && !p_at_end(p)) {
        s.expr = expression(p);
    }
    return s;
}

// Parse a condition/iterable expression with struct literals suppressed, so the
// following `{` is unambiguously the block.
Expr* header_expr(Parser* p) {
    bool saved = p.no_brace;
    p.no_brace = true;
    Expr* e = expression(p);
    p.no_brace = saved;
    return e;
}

Stmt* if_stmt(Parser* p) {
    Token kw = p_advance(p);
    Stmt* s = new_stmt(StIf, kw.line, kw.col);
    s.cond = header_expr(p);
    s.then_block = block(p);
    skip_newlines(p);
    if (p_match(p, TkKwElse)) {
        if (p_check(p, TkKwIf)) { s.else_branch = if_stmt(p); }
        else                    { s.else_branch = block(p); }
    }
    return s;
}

Stmt* while_stmt(Parser* p) {
    Token kw = p_advance(p);
    Stmt* s = new_stmt(StWhile, kw.line, kw.col);
    s.cond = header_expr(p);
    s.body = block(p);
    return s;
}

Stmt* for_stmt(Parser* p) {
    Token kw = p_advance(p);
    Stmt* s = new_stmt(StForIn, kw.line, kw.col);
    s.name = p_expect(p, TkIdent).text;   // loop variable
    p_expect(p, TkKwIn);
    s.iter = header_expr(p);
    s.body = block(p);
    return s;
}

Stmt* region_stmt(Parser* p) {
    Token kw = p_advance(p);
    Stmt* s = new_stmt(StRegion, kw.line, kw.col);
    if (p_check(p, TkIdent)) { s.name = p_advance(p).text; }   // optional region name
    s.body = block(p);
    return s;
}

Stmt* switch_stmt(Parser* p) {
    Token kw = p_advance(p);
    Stmt* s = new_stmt(StSwitch, kw.line, kw.col);
    s.subject = header_expr(p);        // no_brace so the following `{` is the body
    p_expect(p, TkLBrace);
    skip_newlines(p);
    while (!p_check(p, TkRBrace) && !p_at_end(p)) {
        Expr*[] vals = [];
        bool is_def = false;
        Token ct = p_peek(p);
        if (p_check(p, TkKwDefault)) {
            p_advance(p);
            is_def = true;
        } else if (p_check(p, TkKwCase)) {
            p_advance(p);
            bool more = true;
            while (more) { vals.push(expression(p)); more = p_match(p, TkComma); }
        } else {
            p.had_error = true;
            return s;
        }
        p_expect(p, TkColon);
        skip_newlines(p);
        Stmt* body = new_stmt(StBlock, ct.line, ct.col);
        while (!p_check(p, TkKwCase) && !p_check(p, TkKwDefault) && !p_check(p, TkRBrace) && !p_at_end(p)) {
            int before = p.pos;
            body.stmts.push(statement(p));
            if (p.pos == before) { p.had_error = true; p_advance(p); }
            skip_newlines(p);
        }
        s.cases.push(SwitchCase{ vals, body, is_def, ct.line, ct.col });
    }
    p_expect(p, TkRBrace);
    return s;
}

Stmt* statement(Parser* p) {
    switch (p_peek(p).kind) {
        case TkKwReturn: return return_stmt(p);
        case TkKwIf:     return if_stmt(p);
        case TkKwWhile:  return while_stmt(p);
        case TkKwFor:    return for_stmt(p);
        case TkKwRegion: return region_stmt(p);
        case TkKwSwitch: return switch_stmt(p);
        case TkLBrace:   return block(p);
        case TkKwVar, TkKwConst: return var_decl_core(p);
        default:
            if (looks_like_typed_decl(p)) { return var_decl_core(p); }
            return expr_or_assign_core(p);
    }
    return null;
}

// ---- expressions (precedence climbing) --------------------------------

Expr* make_binary(str op, Expr* lhs, Expr* rhs) {
    Expr* e = new_expr(ExBinary, lhs.line, lhs.col);
    e.text = op; e.a = lhs; e.b = rhs;
    return e;
}

// loosest: range `..`, then the C-style ladder
Expr* expression(Parser* p) { return range_expr(p); }

Expr* range_expr(Parser* p) {
    Expr* e = or_expr(p);
    if (p_check(p, TkDotDot)) { p_advance(p); e = make_binary("..", e, or_expr(p)); }
    return e;
}
Expr* or_expr(Parser* p) {
    Expr* e = and_expr(p);
    while (p_check(p, TkPipePipe)) { p_advance(p); e = make_binary("||", e, and_expr(p)); }
    return e;
}
Expr* and_expr(Parser* p) {
    Expr* e = bit_or(p);
    while (p_check(p, TkAmpAmp)) { p_advance(p); e = make_binary("&&", e, bit_or(p)); }
    return e;
}
Expr* bit_or(Parser* p) {
    Expr* e = bit_xor(p);
    while (p_check(p, TkPipe)) { p_advance(p); e = make_binary("|", e, bit_xor(p)); }
    return e;
}
Expr* bit_xor(Parser* p) {
    Expr* e = bit_and(p);
    while (p_check(p, TkCaret)) { p_advance(p); e = make_binary("^", e, bit_and(p)); }
    return e;
}
Expr* bit_and(Parser* p) {
    Expr* e = equality(p);
    while (p_check(p, TkAmp)) { p_advance(p); e = make_binary("&", e, equality(p)); }
    return e;
}
Expr* equality(Parser* p) {
    Expr* e = comparison(p);
    while (p_check(p, TkEqEq) || p_check(p, TkBangEq)) {
        str op = p_advance(p).text;
        e = make_binary(op, e, comparison(p));
    }
    return e;
}
Expr* comparison(Parser* p) {
    Expr* e = shift(p);
    while (p_check(p, TkLt) || p_check(p, TkLtEq) || p_check(p, TkGt) || p_check(p, TkGtEq)) {
        str op = p_advance(p).text;
        e = make_binary(op, e, shift(p));
    }
    return e;
}
Expr* shift(Parser* p) {
    Expr* e = term(p);
    while (p_check(p, TkShl) || p_check(p, TkShr)) {
        str op = p_advance(p).text;
        e = make_binary(op, e, term(p));
    }
    return e;
}
Expr* term(Parser* p) {
    Expr* e = factor(p);
    while (p_check(p, TkPlus) || p_check(p, TkMinus)) {
        str op = p_advance(p).text;
        e = make_binary(op, e, factor(p));
    }
    return e;
}
Expr* factor(Parser* p) {
    Expr* e = unary(p);
    while (p_check(p, TkStar) || p_check(p, TkSlash) || p_check(p, TkPercent)) {
        str op = p_advance(p).text;
        e = make_binary(op, e, unary(p));
    }
    return e;
}

Expr* unary(Parser* p) {
    if (p_check(p, TkBang) || p_check(p, TkMinus) || p_check(p, TkStar) || p_check(p, TkAmp) || p_check(p, TkTilde)) {
        Token op = p_advance(p);
        Expr* u = new_expr(ExUnary, op.line, op.col);
        u.text = op.text;
        u.a = unary(p);
        return u;
    }
    return postfix(p);
}

Expr* postfix(Parser* p) {
    Expr* e = primary(p);
    while (true) {
        if (p_match(p, TkDot)) {
            Expr* f = new_expr(ExField, e.line, e.col);
            f.a = e;
            f.field = p_expect(p, TkIdent).text;
            e = f;
        } else if (p_match(p, TkLParen)) {
            Expr* c = new_expr(ExCall, e.line, e.col);
            c.a = e;
            bool saved = p.no_brace; p.no_brace = false;   // args allow struct literals
            skip_newlines(p);
            if (!p_check(p, TkRParen)) {
                bool more = true;
                while (more) { c.items.push(expression(p)); skip_newlines(p); more = p_match(p, TkComma); skip_newlines(p); }
            }
            p.no_brace = saved;
            p_expect(p, TkRParen);
            e = c;
        } else if (p_match(p, TkLBracket)) {
            Expr* ix = new_expr(ExIndex, e.line, e.col);
            ix.a = e;
            bool saved = p.no_brace; p.no_brace = false;
            ix.b = expression(p);
            p.no_brace = saved;
            p_expect(p, TkRBracket);
            e = ix;
        } else {
            return e;
        }
    }
    return e;
}

Expr* primary(Parser* p) {
    Token t = p_peek(p);
    switch (t.kind) {
        case TkInt:     { p_advance(p); Expr* e = new_expr(ExIntLit, t.line, t.col);    e.text = t.text; return e; }
        case TkFloat:   { p_advance(p); Expr* e = new_expr(ExFloatLit, t.line, t.col);  e.text = t.text; return e; }
        case TkString:  { p_advance(p); Expr* e = new_expr(ExStringLit, t.line, t.col); e.text = t.text; return e; }
        case TkChar:    { p_advance(p); Expr* e = new_expr(ExCharLit, t.line, t.col);   e.text = t.text; return e; }
        case TkKwTrue:  { p_advance(p); Expr* e = new_expr(ExBoolLit, t.line, t.col);   e.bval = true;  return e; }
        case TkKwFalse: { p_advance(p); Expr* e = new_expr(ExBoolLit, t.line, t.col);   e.bval = false; return e; }
        case TkLParen:
            {
                p_advance(p);
                bool saved = p.no_brace; p.no_brace = false;
                Expr* e = expression(p);
                p.no_brace = saved;
                p_expect(p, TkRParen);
                return e;
            }
        case TkLBracket:
            {
                p_advance(p);
                Expr* a = new_expr(ExArrayLit, t.line, t.col);
                bool saved = p.no_brace; p.no_brace = false;
                skip_newlines(p);
                if (!p_check(p, TkRBracket)) {
                    bool more = true;
                    while (more) { a.items.push(expression(p)); skip_newlines(p); more = p_match(p, TkComma); skip_newlines(p); }
                }
                p.no_brace = saved;
                p_expect(p, TkRBracket);
                return a;
            }
        case TkIdent:
            {
                if (!p.no_brace && p_peek_at(p, 1).kind == TkLBrace) {
                    p_advance(p);   // name
                    p_advance(p);   // {
                    Expr* s = new_expr(ExStructLit, t.line, t.col);
                    s.type_name = t.text;
                    bool saved = p.no_brace; p.no_brace = false;
                    skip_newlines(p);
                    if (!p_check(p, TkRBrace)) {
                        bool more = true;
                        while (more) { s.items.push(expression(p)); skip_newlines(p); more = p_match(p, TkComma); skip_newlines(p); }
                    }
                    p.no_brace = saved;
                    p_expect(p, TkRBrace);
                    return s;
                }
                p_advance(p);
                Expr* e = new_expr(ExName, t.line, t.col);
                e.text = t.text;
                return e;
            }
        default:
            p.had_error = true;
            p_advance(p);
            return new_expr(ExName, t.line, t.col);
    }
    return new_expr(ExName, t.line, t.col);
}
