# --- build artifacts -------------------------------------------------------
# `stratac build/run` emit <stem>.c/.exe next to the .strata source. None of that is
# source; only the .strata files are.

# stratac output beside the compiler's own sources (build.ps1 builds src/stratac.strata)
compiler/src/*.c
compiler/src/*.exe

# stratac output beside example programs
compiler/examples/*.c
compiler/examples/*.exe

# old D-- build output left in the archived bootstrap seed
archive/dminusminus-seed/src/*.c
archive/dminusminus-seed/src/*.exe

# build output directory (stratac.exe, console.exe, libstrata.dll, libstrata.c)
compiler/bin/
# bootstrap: the cached pinned release + stage1/2 compilers (see compiler/build.ps1)
compiler/build/

# packaged release archives (uploaded to GitHub Releases, not committed)
compiler/dist/

# generic native/build leftovers
*.o
*.obj
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.lib

# --- editor / OS -----------------------------------------------------------
.vs/
.vscode/
.idea/
*.swp
*.user
Thumbs.db
.DS_Store
